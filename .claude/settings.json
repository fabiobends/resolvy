{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/type-check.sh",
            "statusMessage": "Running type check..."
          }
        ]
      }
    ]
  },
  "Stop": {
    "hooks": [
      {
        "type": "agent",
        "prompt": "Use agents/code-shaper.md to check code shape and style.",
        "statusMessage": "Running code shaper agent..."
      }
    ]
  }
}
