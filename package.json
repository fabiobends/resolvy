{
  "name": "resolvy",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:dev": "expo start --ios",
    "android:dev": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "type:check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^3.0.2",
    "@react-navigation/native": "^7.1.33",
    "expo": "~55.0.17",
    "expo-constants": "~55.0.15",
    "expo-linking": "~55.0.14",
    "expo-router": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "^10.4.0",
    "@storybook/addon-ondevice-backgrounds": "^10.4.0",
    "@storybook/addon-ondevice-controls": "^10.4.0",
    "@storybook/react-native": "^10.4.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@typescript-eslint/utils": "^8.59.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-expo": "^55.0.16",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react-test-renderer": "19.2.0",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md}": "prettier --write"
  },
  "private": true
}
